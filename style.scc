* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f7f8fc;
    color: #222;
    line-height: 1.6;
}

/* NAVBAR */
header {
    background: #111827;
    position: sticky;
    top: 0;
    z-index: 1000;
}

nav {
    max-width: 1100px;
    margin: auto;
    padding: 18px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav h2 {
    color: white;
    font-size: 25px;
}

.nav-links {
    display: flex;
    gap: 25px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-weight: 500;
}

.nav-links a:hover {
    color: #60a5fa;
}

/* COMMON SECTION */
section {
    max-width: 1100px;
    margin: auto;
    padding: 80px 25px;
}

.section-title {
    text-align: center;
    font-size: 34px;
    margin-bottom: 40px;
    color: #111827;
}

/* HOME */
.hero {
    min-height: 90vh;
    max-width: none;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: linear-gradient(135deg, #eef2ff, #f8fafc);
}

.hero-content {
    max-width: 750px;
}

.small-text {
    color: #2563eb;
    font-size: 20px;
    font-weight: bold;
}

.hero h1 {
    font-size: 55px;
    color: #111827;
    margin: 10px 0;
}

.hero h2 {
    font-size: 27px;
    color: #2563eb;
    margin-bottom: 20px;
}

.hero p {
    font-size: 18px;
    color: #555;
}

.buttons {
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    background: #2563eb;
    color: white;
    padding: 12px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
}

.btn:hover {
    background: #1d4ed8;
}

.btn.outline {
    background: transparent;
    color: #2563eb;
    border: 2px solid #2563eb;
}

/* ABOUT */
.card {
    background: white;
    padding: 35px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    max-width: 850px;
    margin: auto;
}

.card h3 {
    font-size: 24px;
    margin-bottom: 15px;
}

.card p {
    margin-bottom: 15px;
    color: #555;
}

/* SKILLS */
.skills-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.skill-card {
    background: white;
    padding: 30px 20px;
    text-align: center;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: 0.3s;
}

.skill-card:hover {
    transform: translateY(-7px);
}

.skill-card h3 {
    margin-bottom: 10px;
}

.skill-card p {
    color: #666;
}

/* PROJECTS */
.projects-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.project-card {
    background: white;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-7px);
}

.project-card h3 {
    margin-bottom: 15px;
    color: #111827;
}

.project-card p {
    color: #666;
    margin-bottom: 20px;
}

.project-card span {
    display: inline-block;
    background: #eef2ff;
    color: #2563eb;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 14px;
}

/* CONTACT */
.contact-card {
    max-width: 700px;
    margin: auto;
    background: white;
    padding: 35px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    text-align: center;
}

.contact-card p {
    margin: 15px 0;
}

.contact-card a {
    color: #2563eb;
    text-decoration: none;
}

/* FOOTER */
footer {
    background: #111827;
    color: white;
    text-align: center;
    padding: 25px;
}

/* MOBILE */
@media (max-width: 768px) {

    nav {
        flex-direction: column;
        gap: 15px;
    }

    .nav-links {
        gap: 12px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero h1 {
        font-size: 40px;
    }

    .hero h2 {
        font-size: 23px;
    }

    .skills-container {
        grid-template-columns: 1fr 1fr;
    }

    .projects-container {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 500px) {

    .skills-container {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 32px;
    }

    .section-title {
        font-size: 28px;
    }
}